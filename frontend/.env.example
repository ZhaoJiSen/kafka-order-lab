# 宿主机 PHP 模式。Docker PHP 模式请改为 http://127.0.0.1:18080。
PHP_API_URL=http://127.0.0.1:8000
JAVA_API_URL=http://127.0.0.1:18081
KAFKA_BROKERS=127.0.0.1:19092
OBSERVER_PORT=3010
# native 读取本机 Laravel 日志；docker 读取本 Demo 的 PHP 容器日志。
PHP_RUNTIME=native
# native 读取本机 Spring Boot 日志；docker 读取本 Demo 的 Java 容器日志。
JAVA_RUNTIME=native
