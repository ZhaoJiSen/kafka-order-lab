FROM php:8.4-cli-bookworm AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    librdkafka-dev libonig-dev libsqlite3-dev libxml2-dev unzip git curl \
    && docker-php-ext-install -j2 mbstring pdo_sqlite pcntl \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL --retry 3 https://pecl.php.net/get/rdkafka-6.0.5.tgz -o /tmp/rdkafka.tgz \
    && pecl install /tmp/rdkafka.tgz && docker-php-ext-enable rdkafka && rm /tmp/rdkafka.tgz
RUN curl -fsSL --retry 3 https://getcomposer.org/download/2.10.3/composer.phar -o /usr/local/bin/composer && chmod +x /usr/local/bin/composer
WORKDIR /app
ENV COMPOSER_ALLOW_SUPERUSER=1
